{
  "name": "@programmable/launch",
  "version": "4.1.5",
  "packageManager": "npm@11.16.0",
  "description": "Deterministic pack, validation, submission, and status tooling for the Programmable Custom Launch API",
  "type": "module",
  "bin": {
    "programmable-launch": "bin/programmable-launch.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "contracts",
    "src",
    "schemas",
    "examples",
    "test/fixtures/programmable-settlement-fee-vault-v1.json",
    "test/fixtures/programmable-settlement-fee-vault-v1.standard-json.json",
    "npm-shrinkwrap.json",
    "README.md"
  ],
  "scripts": {
    "test": "npm run verify:machine-contracts && node --test test/*.test.mjs",
    "verify:machine-contracts": "node scripts/verify-public-machine-contracts.mjs && node scripts/sync-v41-machine-contracts.mjs --check",
    "pack:dry-run": "npm pack --dry-run",
    "sbom": "npm sbom --package-lock-only --omit=dev --sbom-format=cyclonedx --sbom-type=application"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "dependencies": {
    "viem": "2.55.5"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "solc": "0.8.26"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programmablehq/PROGRAMMABLE.git",
    "directory": "packages/launch"
  },
  "homepage": "https://programmable.market/docs/developers/custom-launch",
  "bugs": {
    "url": "https://github.com/programmablehq/PROGRAMMABLE/issues"
  }
}
